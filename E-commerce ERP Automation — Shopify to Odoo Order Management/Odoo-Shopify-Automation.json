        "jsCode": "const customerId = $input.first().json.id;\nconst allItems = $('Extract Product Data').all();\n\nreturn allItems.map(item => ({\n  json: {\n    odoo_customer_id: customerId,\n    product_sku: item.json.product_sku,\n    product_qty: item.json.product_qty,\n    product_price: item.json.product_price,\n    product_name: item.json.product_name,\n    shopify_order_id: item.json.shopify_order_id,\n    order_amount: item.json.order_amount,\n    customer_name: item.json.customer_name,\n    customer_email: item.json.customer_email\n  }\n}));"
      },

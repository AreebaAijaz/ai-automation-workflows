    {
      "parameters": {
        "jsCode": "// Safely grab the inputs\nconst salesOrderId = $input.first()?.json?.id;\nconst shopifyData = $('Shopify Trigger').first()?.json;\nconst allProducts = $('Find Product in Odoo').all();\n\n// Safely handle line_items in case they are missing entirely\nlet shopifyItems = [];\nif (shopifyData && shopifyData.line_items) {\n  shopifyItems = Array.isArray(shopifyData.line_items)\n    ? shopifyData.line_items\n    : [shopifyData.line_items];\n}\n\nconst items = [];\n\nfor (let i = 0; i < shopifyItems.length; i++) {\n  // Safely check if the Odoo product result exists at this index\n  const odooResult = allProducts[i]?.json?.result;\n  \n  // If it exists and has at least one item, get the ID. Otherwise, return null.\n  const productId = (odooResult && odooResult.length > 0) ? odooResult[0].id : null;\n\n  items.push({\n    json: {\n      sales_order_id: salesOrderId || null,\n      product_id: productId,\n      quantity: shopifyItems[i].quantity || 0,\n      price: shopifyItems[i].price || '0.00',\n      name: shopifyItems[i].name ? String(shopifyItems[i].name) : 'Unknown Product'\n    }\n  });\n}\n\nreturn items;"
      },

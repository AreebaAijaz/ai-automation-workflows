      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n  return {\n    json: {\n    customer_name: data.shipping_address.name.replace(/[\\n\\r]/g, '').trim(),\n      customer_email: data.customer.email.replace(/[\\n\\r]/g, '').trim(),\n      shopify_order_id: data.name,\n      order_amount: data.current_total_price,\n      currency: data.currency,\n      product_sku: data.line_items.sku.replace(/[\\n\\r]/g, '').trim(),\n      product_qty: data.line_items.quantity,\n      product_price: parseFloat(data.line_items.price),\n      product_name: data.line_items.name.replace(/[\\n\\r]/g, '').trim(),\n      street: data.shipping_address.address1,\n      street2: data.shipping_address.address2,\n      city: data.shipping_address.city,\n      zip: data.shipping_address.zip,\n      country: data.shipping_address.country\n    }\n  };\n});"
      },

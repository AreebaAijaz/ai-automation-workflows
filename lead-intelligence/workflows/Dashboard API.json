      "id": "b08bc1c1-d2ec-4fbe-99ba-5a122c0174c9",
      "name": "Code for POST method"
    },
    {
      "parameters": {
        "jsCode": "// Transform Google Sheets data into clean JSON\nconst items = $input.all();\n\nconst leads = items.map(item => {\n  const row = item.json;\n  \n  return {\n    id: row.id || '',\n    timestamp: row.timestamp || '',\n    name: row.name || '',\n    email: row.email || '',\n    company: row.company || '',\n    message: row.message || '',\n    source: row.source || 'webhook',\n    score: parseInt(row.score) || 0,\n    tier: row.tier || 'cold',\n    insights: (() => {\n      try {\n        return JSON.parse(row.insights || '[]');\n      } catch (e) {\n        return [];\n      }\n    })(),\n    red_flags: (() => {\n      try {\n        return JSON.parse(row.red_flags || '[]');\n      } catch (e) {\n        return [];\n      }\n    })(),\n    suggested_action: row.suggested_action || '',\n    status: row.status || 'new',\n    assigned_to: row.assigned_to || 'unassigned'\n  };\n});\n\n// Sort by timestamp (newest first)\nleads.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\n\n// Calculate stats\nconst stats = {\n  total: leads.length,\n  hot: leads.filter(l => l.tier === 'hot').length,\n  warm: leads.filter(l => l.tier === 'warm').length,\n  cold: leads.filter(l => l.tier === 'cold').length,\n  today: leads.filter(l => {\n    const today = new Date().toDateString();\n    return new Date(l.timestamp).toDateString() === today;\n  }).length\n};\n\nreturn {\n  json: {\n    leads: leads,\n    stats: stats,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

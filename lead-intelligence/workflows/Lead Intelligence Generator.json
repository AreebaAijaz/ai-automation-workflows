    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nconst webhookData = $('Webhook').first().json.body;\n\n// Raw AI output text\nconst raw = aiResponse.output;\n\n// Extract score\nconst scoreMatch = raw.match(/\"score\":\\s*(\\d+)/);\nconst score = scoreMatch ? Number(scoreMatch[1]) : null;\n\n\n// Extract tier\nconst tierMatch = raw.match(/\"tier\":\\s*\"([^\"]+)\"/);\nconst tier = tierMatch ? tierMatch[1] : \"\";\n\n// Extract suggested_action (optional)\nconst actionMatch = raw.match(/\"suggested_action\":\\s*\"([^\"]+)\"/);\nconst suggested_action = actionMatch ? actionMatch[1] : \"\";\n\n// Extract insights array as readable text\nconst insightsMatch = raw.match(/\"insights\":\\s*\\[(.*?)\\]/s);\nlet insights = [];\n\nif (insightsMatch) {\n  // Extract inner content like \"Insight 1\",\"Insight 2\"\n  insights = insightsMatch[1]\n    .match(/\"([^\"]+)\"/g) // grab each quoted string\n    ?.map(i => i.replace(/\"/g, '')) || [];\n}\n\n// Return clean data\nreturn {\n  json: {\n    score,\n    tier,\n    insights,\n    suggested_action,\n    name: webhookData.name,\n    email: webhookData.email,\n    company: webhookData.company,\n    message: webhookData.message\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
